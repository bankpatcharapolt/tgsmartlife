		LEFT JOIN `product` ON `product_regis`.`product_id` = `product`.`id`
		where `product_regis`.`bill_number` = '".$register_code."' OR `product_regis`.`tel_cus` = '".$register_code."' OR `product_regis`.`tel_idcart` = '".$register_code."' ";

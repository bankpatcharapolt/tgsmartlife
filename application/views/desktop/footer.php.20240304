<script>
    var base_url = "<?=base_url();?>";
    drawgenerals(base_url);
    function drawgenerals(base_url){
        //###  ressults ###//
        var results = get_general_results(base_url);
        if(results.datas.length > 0){
            var conpany_contact = '';
            $.each( results.datas, function( key, val ) {
                switch (val.method) {
                    case 'companyname':
                        if(val.text != '' && val.text != null){
                            var html = '<b>'+val.text+'</b>';
                            $('.footer .footer__about .company_name').html(html);
                        }
                    break;
                    case 'callcenter':
                        if(val.text != '' && val.text != null){
                            conpany_contact += ' '+val.text;
                            $('.offcanvas__text .company_call').html('<a href="tel:call center :'+val.text+'">Call Center : '+val.text+'</a>');
                            $('.header__top .header__top__links .company_call').html('Call Center : '+val.text);
                            $('.header__top .header__top__links .company_call').attr('href', 'tel:'+val.text);
                            
                            // $('.product__details__cart__option .call-center a').html('Call Center : '+val.text);
                            // $('.product__details__cart__option .call-center a').attr('href', 'tel:'+val.text);
                        }
                    break;
                    case 'servicenumber':
                        if(val.text != '' && val.text != null){
                            conpany_contact += ' '+val.text;
                            $('.offcanvas__text .company_service').html('<a href="tel:service center :'+val.text+'">Service : '+val.text+'</a>');
                            $('.header__top .header__top__links .company_service').html('Service : '+val.text);
                            $('.header__top .header__top__links .company_service').attr('href', 'tel:'+val.text);

                            //$('.product__details__cart__option .line-tag a').html(val.text);
                        }
                    break;
                    case 'emailcompany':
                        if(val.text != '' && val.text != null){
                            var html = '<i class="fa fa-envelope" aria-hidden="true"></i><a class="text-white" href="mailto:'+val.text+'"> '+val.text+'</a>';
                            $('.footer .footer__about .company_email').html(html);
                        }
                    break;
                    case 'taxidentification':
                        if(val.text != '' && val.text != null){
                            $('.footer .footer__about .company_tax').html('เลขประจำตัวผู้เสียภาษี '+val.text);
                        }
                    break;
                    case 'facebook':
                        if(val.text != '' && val.text != null){
                            $('.offcanvas__links .company_facebook').attr('href', val.text);
                            $('.header__top .tg__social .company_facebook').attr('href', val.text);
                        }
                    break;
                    case 'line':
                        if(val.text != '' && val.text != null){
                            $('.offcanvas__links .company_facebook').attr('href', val.text);
                            $('.header__top .tg__social .company_line').attr('href', val.text);
                            
                            $('.product__details__cart__option .line-tag a').attr('href', val.text);
                        }
                    break;
                    default:
                        break;
                }
                
            });
            $('.footer .footer__about .company_contact').html('<i class="fa fa-phone" aria-hidden="true"></i>'+conpany_contact);
        }
    }
    function get_general_results(base_url){
        var res = null;
        $.ajax({
            url: base_url+'Main/get_general_results', //ทำงานกับไฟล์นี้
            data: '',  //ส่งตัวแปร
            type: "POST",
            dataType: 'json',
            async:false,
            success: function(data, status) {
                res = data;
            },
            error: function(xhr, status, exception) { 
                //console.log(xhr);
            }
        });
        return res;
    }
</script>